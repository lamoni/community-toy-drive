{
  "name": "community-toy-drive",
  "version": "1.0.0",
  "description": "An open-source website for running a community Christmas toy drive: family requests, donor/volunteer sign-ups, and an admin dashboard. Deploys to AWS with Terraform.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --watch-path=src --watch-path=templates --watch-path=public --watch-path=private --env-file-if-exists=.env server.js",
    "deploy": "node scripts/build.js && terraform -chdir=infra apply"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  }
}
